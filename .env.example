# Public Supabase project settings. These values are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never expose this value to client code or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# Base URL used for OAuth and password-reset callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
