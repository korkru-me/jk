# Public Supabase project settings. These values are exposed to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never expose this value to client code or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# At least 32 random characters. Vercel Cron sends this value as a Bearer
# token to the private daily math-work orphan cleanup route.
CRON_SECRET=

# Base URL used for OAuth and password-reset callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Safe Exam Browser phase 1. Generate CK/BEKs with the official SEB Config
# Tool; those values are 64-character SHA-256 hex. Never expose these
# server-only values through NEXT_PUBLIC_* variables.
SEB_SESSION_SECRET=
SEB_CONFIG_KEY=
# Comma-separated BEKs for every allowed SEB platform/version build.
SEB_BROWSER_EXAM_KEYS=

# Public HTTPS URL of the encrypted .seb settings file students should open.
NEXT_PUBLIC_SEB_CONFIG_URL=

# SEB per-exam PASSWORD DRAFTS only; does not enable native/server integration.
# Keep disabled until the draft migration and dedicated keyring are ready.
# Prepare private key material with: npm run seb:password:prepare-keyring
# KEYRING is a JSON object mapping key IDs to canonical base64 32-byte keys.
# Never reuse SEB_SESSION_SECRET or expose these with NEXT_PUBLIC_*.
SEB_PASSWORD_DRAFTS_ENABLED=false
SEB_PASSWORD_ACTIVE_KEY_ID=
SEB_PASSWORD_KEYRING=
