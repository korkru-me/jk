# Public Supabase project settings. These values are exposed to the browser.
# Omit locally to infer local. Set explicitly to staging on Preview; existing
# Vercel Production safely infers production from VERCEL_ENV.
KORKRU_DEPLOYMENT_ENV=local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret. Never expose this value to client code or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# At least 32 random characters. Vercel Cron sends this value as a Bearer
# token to the private daily math-work orphan cleanup route.
CRON_SECRET=

# Base URL used for OAuth and password-reset callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only, separate random value (32+ characters) per environment. Signs
# recovery intents/grants and Google linking challenges, plus HMACs for
# anonymous email/IP rate-limit keys.
# Apply auth_email_request_limits before enabling email actions. Missing
# secret/schema fails closed instead of sending unthrottled email.
AUTH_FLOW_SECRET=

# Same-email Google connection in account settings. Uses the existing Google
# web OAuth Client ID (public identifier), also configured in Supabase. Add this
# app's origins in Google Cloud. Keep the rollout gate off until Staging passes.
# Does not require enabling Supabase Manual Linking.
GOOGLE_ACCOUNT_LINKING_ENABLED=false
GOOGLE_ACCOUNT_LINK_CLIENT_ID=

# Server-only rollout gate for the no-score self-practice library. Keep false
# until its schema/RLS and authenticated Staging UAT have passed.
PRACTICE_LIBRARY_ENABLED=false
# At least 32 random characters; signs short-lived per-student question variants.
PRACTICE_VARIANT_SECRET=

# Safe Exam Browser phase 1. Generate CK/BEKs with the official SEB Config
# Tool; those values are 64-character SHA-256 hex. Never expose these
# server-only values through NEXT_PUBLIC_* variables.
SEB_SESSION_SECRET=
SEB_CONFIG_KEY=
# Immutable revision id from config/seb-release-registry.json.
SEB_CONFIG_REVISION=
# One-line JSON kept in the secret manager. Schema:
# {"schemaVersion":1,"configRevision":"...","entries":[{"platform":"windows|macos|ios","versionString":"...","buildNumber":"...","key":"64-hex-BEK"}]}
SEB_BROWSER_EXAM_KEY_REGISTRY=

# Public HTTPS URL of the encrypted .seb settings file students should open.
NEXT_PUBLIC_SEB_CONFIG_URL=
# Server-only grader callback. Use a separate random secret per environment;
# configure the matching HTTPS callback URL/secret in Supabase Vault at rollout.
ATTEMPT_FINALIZER_SECRET=

# Resend quota alert webhook (server-only). SMTP credentials belong in Supabase,
# not in NEXT_PUBLIC_* variables. See docs/RESEND_SETUP.md for rollout steps.
RESEND_QUOTA_ALERTS_ENABLED=false
# Separate Full access key: GET /usage needs more than Sending access.
RESEND_QUOTA_API_KEY=
# Signing secret for this environment's /api/webhooks/resend endpoint.
RESEND_QUOTA_WEBHOOK_SECRET=
# Bare email address on the Resend-verified sending domain.
RESEND_QUOTA_ALERT_FROM=
RESEND_QUOTA_ALERT_TO=
