# Copy to .env.qa.local. This file is for an isolated QA deployment only.
# Never point it at the production Supabase project or production site.
EXAM_QA_ENVIRONMENT=staging
KORKRU_DEPLOYMENT_ENV=staging
VERCEL_ENV=preview

NEXT_PUBLIC_SITE_URL=https://staging.example.test
EXAM_QA_PRODUCTION_SITE_URL=https://www.example.test

NEXT_PUBLIC_SUPABASE_URL=https://staging-project-ref.supabase.co
EXAM_QA_PRODUCTION_SUPABASE_URL=https://production-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Phase S5 synthetic mock policy. Keep writes disabled until the exact run is
# explicitly approved; the runner also requires a unique seb-s5-* run id and
# an independent confirmation phrase before it may create any fixture.
EXAM_QA_DATA_POLICY=synthetic-only
EXAM_QA_COPY_PRODUCTION_DATA=false
EXAM_QA_ALLOW_SYNTHETIC_WRITES=false
# Enables only the tightly scoped, authenticated synthetic-account seam used
# to prove expired SEB challenge/session rejection without waiting 5m/12h.
EXAM_QA_SEB_TIME_CONTROL=false

# Plaintext assignment configs are accepted only by isolated Staging while the
# native Windows enrollment flow is being proven. Production must never set it.
SEB_ALLOW_TEST_ONLY_ASSIGNMENT_CONFIGS=true

# Server-only database connection for fresh-project bootstrap in phase 2C.
# Never commit or paste the real value into chat/logs.
EXAM_QA_STAGING_DATABASE_URL=
